## Deploy environment matrix template (staging/production)
## Copy to your real environment file and replace all placeholders.
## Do not commit real values.

# Runtime profile
DEPLOY_ENV=staging
RUN_SEED=false
# Kept as fallback; each service in compose overrides this value.
SERVICE_PROFILE=monolith

# Images
BACKEND_IMAGE=ghcr.io/your-org/travel-backend:replace-me
GATEWAY_IMAGE=ghcr.io/your-org/travel-gateway:replace-me

# PostgreSQL
POSTGRES_DB=travel
POSTGRES_USER=travel_app
POSTGRES_PASSWORD=replace_with_strong_password
DATABASE_URL=postgresql+psycopg2://travel_app:replace_with_strong_password@postgres:5432/travel

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=100
REDIS_SOCKET_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=2.0

# Backend core
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
JWT_SECRET=replace_with_min_32_chars_secret
JWT_ISSUER=alats-travel
CORS_ORIGINS=["https://staging.example.com"]

# Kafka
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=travel-backend
KAFKA_TOPIC_FAVORITE=favorite-events
KAFKA_TOPIC_RATING=rating-events
KAFKA_TOPIC_DESTINATION=destination-events
KAFKA_TOPIC_VIEW=view-events
KAFKA_DLQ_TOPIC=travel-events-dlq
KAFKA_CONSUMER_GROUP=travel-worker-group

# Elasticsearch
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=travel_destinations
SEARCH_USE_ELASTICSEARCH=true

# Worker
WORKER_RETRY_MAX=3
WORKER_RETRY_BACKOFF_SECONDS=0.5

# Destination image pipeline
DESTINATION_IMAGE_CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=travel/destinations
DESTINATION_IMAGE_TIMEOUT_SECONDS=8.0
DESTINATION_IMAGE_MAX_BYTES=8000000
DESTINATION_IMAGE_UPLOAD_CONCURRENCY=3
DESTINATION_IMAGE_BACKFILL_BATCH_SIZE=50
DESTINATION_IMAGE_BACKFILL_SLEEP_SECONDS=0.0
DESTINATION_IMAGE_BACKFILL_CHECKPOINT_FILE=./.runtime/destination_image_backfill_checkpoint.json
